# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Portal Configuration
NEXT_PUBLIC_ADMIN_EMAIL=praveeng8969@gmail.com
ADMIN_DEFAULT_PASSWORD=PRAVEEN@008969

# Razorpay Payment Gateway Configuration
# Client-side visible key (Starts with rzp_test_ or rzp_live_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Server-only secret key (NEVER expose to frontend)
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere

# Razorpay Webhook Secret (Configured in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
